<%- include('../partials/header') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<%- include('../partials/admin-nav') %>
  <section class="admin-section">
    <div class="container">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
        <div>
          <h1 class="admin-page-title" style="margin-bottom:4px;">Dashboard</h1>
          <p style="color:var(--gray-500);font-size:0.85rem;">Bienvenido, <%= admin %>. Gestiona tu tienda aquí.</p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <a href="/admin/productos/nuevo" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Nuevo Producto</a>
          <a href="/admin/slides" class="btn btn-outline btn-sm"><i class="fas fa-images"></i> Sliders</a>
          <a href="/admin/giftcard" class="btn btn-outline btn-sm"><i class="fas fa-gift"></i> Gift Card</a>
        </div>
      </div>

      <div class="dashboard-grid" style="grid-template-columns:repeat(4,1fr);">
        <div class="dashboard-card" style="border-left:4px solid var(--gold);transition:transform 0.3s,box-shadow 0.3s;" onmouseover="this.style.transform='translateY(-4px)';this.style.boxShadow='0 8px 25px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
          <div class="dashboard-card-icon" style="background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:#fff;">
            <i class="fas fa-shoe-prints"></i>
          </div>
          <div class="dashboard-card-info">
            <h3 class="counter" data-target="<%= total %>">0</h3>
            <p>Total Productos</p>
          </div>
        </div>
        <div class="dashboard-card" style="border-left:4px solid var(--success);transition:transform 0.3s,box-shadow 0.3s;" onmouseover="this.style.transform='translateY(-4px)';this.style.boxShadow='0 8px 25px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
          <div class="dashboard-card-icon" style="background:linear-gradient(135deg,#16a34a,#15803d);color:#fff;">
            <i class="fas fa-check-circle"></i>
          </div>
          <div class="dashboard-card-info">
            <h3 class="counter" data-target="<%= activos %>">0</h3>
            <p>Productos Activos</p>
          </div>
        </div>
        <div class="dashboard-card" style="border-left:4px solid var(--sale);transition:transform 0.3s,box-shadow 0.3s;" onmouseover="this.style.transform='translateY(-4px)';this.style.boxShadow='0 8px 25px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
          <div class="dashboard-card-icon" style="background:linear-gradient(135deg,#dc2626,#b91c1c);color:#fff;">
            <i class="fas fa-tags"></i>
          </div>
          <div class="dashboard-card-info">
            <h3 class="counter" data-target="<%= ofertas %>">0</h3>
            <p>En Oferta</p>
          </div>
        </div>
        <div class="dashboard-card" style="border-left:4px solid #7c3aed;transition:transform 0.3s,box-shadow 0.3s;" onmouseover="this.style.transform='translateY(-4px)';this.style.boxShadow='0 8px 25px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
          <div class="dashboard-card-icon" style="background:linear-gradient(135deg,#7c3aed,#6d28d9);color:#fff;">
            <i class="fas fa-percentage"></i>
          </div>
          <div class="dashboard-card-info">
            <h3><%= total > 0 ? Math.round((activos / total) * 100) : 0 %>%</h3>
            <p>Activos / Total</p>
          </div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-top:24px;">
        <div style="background:var(--white);border-radius:8px;padding:24px;box-shadow:0 2px 8px rgba(0,0,0,0.05);">
          <h3 style="font-family:var(--font-serif);font-size:1.1rem;margin-bottom:16px;padding-bottom:12px;border-bottom:2px solid var(--gold-light);"><i class="fas fa-bolt" style="color:var(--gold);margin-right:8px;"></i>Acciones Rápidas</h3>
          <div style="display:flex;flex-direction:column;gap:10px;">
            <a href="/admin/productos/nuevo" style="display:flex;align-items:center;gap:12px;padding:12px 16px;background:var(--gray-100);border-radius:6px;text-decoration:none;color:var(--black);transition:all 0.3s;" onmouseover="this.style.background='var(--gold)';this.style.color='#fff'" onmouseout="this.style.background='var(--gray-100)';this.style.color='var(--black)'">
              <i class="fas fa-plus-circle" style="color:var(--gold);font-size:1.1rem;"></i>
              <span>Agregar nuevo producto</span>
            </a>
            <a href="/admin/productos" style="display:flex;align-items:center;gap:12px;padding:12px 16px;background:var(--gray-100);border-radius:6px;text-decoration:none;color:var(--black);transition:all 0.3s;" onmouseover="this.style.background='var(--gold)';this.style.color='#fff'" onmouseout="this.style.background='var(--gray-100)';this.style.color='var(--black)'">
              <i class="fas fa-list" style="color:var(--gold);font-size:1.1rem;"></i>
              <span>Gestionar productos</span>
            </a>
            <a href="/admin/politicas" style="display:flex;align-items:center;gap:12px;padding:12px 16px;background:var(--gray-100);border-radius:6px;text-decoration:none;color:var(--black);transition:all 0.3s;" onmouseover="this.style.background='var(--gold)';this.style.color='#fff'" onmouseout="this.style.background='var(--gray-100)';this.style.color='var(--black)'">
              <i class="fas fa-file-alt" style="color:var(--gold);font-size:1.1rem;"></i>
              <span>Editar políticas</span>
            </a>
            <a href="/admin/ajustes" style="display:flex;align-items:center;gap:12px;padding:12px 16px;background:var(--gray-100);border-radius:6px;text-decoration:none;color:var(--black);transition:all 0.3s;" onmouseover="this.style.background='var(--gold)';this.style.color='#fff'" onmouseout="this.style.background='var(--gray-100)';this.style.color='var(--black)'">
              <i class="fas fa-cog" style="color:var(--gold);font-size:1.1rem;"></i>
              <span>Ajustes del sitio</span>
            </a>
          </div>
        </div>

        <div style="background:var(--white);border-radius:8px;padding:24px;box-shadow:0 2px 8px rgba(0,0,0,0.05);">
          <h3 style="font-family:var(--font-serif);font-size:1.1rem;margin-bottom:16px;padding-bottom:12px;border-bottom:2px solid var(--gold-light);"><i class="fas fa-link" style="color:var(--gold);margin-right:8px;"></i>Accesos Directos</h3>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
            <a href="/admin/slides" style="display:flex;flex-direction:column;align-items:center;gap:8px;padding:20px 12px;background:var(--gray-100);border-radius:8px;text-decoration:none;color:var(--black);transition:all 0.3s;" onmouseover="this.style.background='var(--gold)';this.style.color='#fff'" onmouseout="this.style.background='var(--gray-100)';this.style.color='var(--black)'">
              <i class="fas fa-images" style="color:var(--gold);font-size:1.4rem;"></i>
              <span style="font-size:0.8rem;font-weight:500;">Sliders</span>
            </a>
            <a href="/admin/giftcard" style="display:flex;flex-direction:column;align-items:center;gap:8px;padding:20px 12px;background:var(--gray-100);border-radius:8px;text-decoration:none;color:var(--black);transition:all 0.3s;" onmouseover="this.style.background='var(--gold)';this.style.color='#fff'" onmouseout="this.style.background='var(--gray-100)';this.style.color='var(--black)'">
              <i class="fas fa-gift" style="color:var(--gold);font-size:1.4rem;"></i>
              <span style="font-size:0.8rem;font-weight:500;">Gift Card</span>
            </a>
            <a href="/" target="_blank" style="display:flex;flex-direction:column;align-items:center;gap:8px;padding:20px 12px;background:var(--gray-100);border-radius:8px;text-decoration:none;color:var(--black);transition:all 0.3s;" onmouseover="this.style.background='var(--gold)';this.style.color='#fff'" onmouseout="this.style.background='var(--gray-100)';this.style.color='var(--black)'">
              <i class="fas fa-globe" style="color:var(--gold);font-size:1.4rem;"></i>
              <span style="font-size:0.8rem;font-weight:500;">Ver Sitio</span>
            </a>
            <a href="/admin/ajustes" style="display:flex;flex-direction:column;align-items:center;gap:8px;padding:20px 12px;background:var(--gray-100);border-radius:8px;text-decoration:none;color:var(--black);transition:all 0.3s;" onmouseover="this.style.background='var(--gold)';this.style.color='#fff'" onmouseout="this.style.background='var(--gray-100)';this.style.color='var(--black)'">
              <i class="fas fa-palette" style="color:var(--gold);font-size:1.4rem;"></i>
              <span style="font-size:0.8rem;font-weight:500;">Apariencia</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll('.counter').forEach(function(el) {
      var target = parseInt(el.getAttribute('data-target'));
      var current = 0;
      var step = Math.max(1, Math.ceil(target / 30));
      var interval = setInterval(function() {
        current += step;
        if (current >= target) { current = target; clearInterval(interval); }
        el.textContent = current;
      }, 40);
    });
  </script>
<%- include('../partials/footer') %>
