<%- include('../partials/header') %>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<%- include('../partials/admin-nav') %>
  <section class="admin-section">
    <div class="container">
      <h1 class="admin-page-title">Dashboard</h1>
      <div class="dashboard-grid">
        <div class="dashboard-card">
          <div class="dashboard-card-icon"><i class="fas fa-shoe-prints"></i></div>
          <div class="dashboard-card-info">
            <h3><%= total %></h3>
            <p>Total Productos</p>
          </div>
        </div>
        <div class="dashboard-card">
          <div class="dashboard-card-icon active-icon"><i class="fas fa-check-circle"></i></div>
          <div class="dashboard-card-info">
            <h3><%= activos %></h3>
            <p>Productos Activos</p>
          </div>
        </div>
        <div class="dashboard-card">
          <div class="dashboard-card-icon sale-icon"><i class="fas fa-tags"></i></div>
          <div class="dashboard-card-info">
            <h3><%= ofertas %></h3>
            <p>En Oferta</p>
          </div>
        </div>
        <div class="dashboard-card">
          <div class="dashboard-card-icon"><i class="fas fa-images"></i></div>
          <div class="dashboard-card-info">
            <h3><a href="/admin/slides" style="color:inherit;text-decoration:none;">Sliders</a></h3>
            <p>Administrar Sliders</p>
          </div>
        </div>
      </div>
      <div class="dashboard-actions">
        <a href="/admin/productos/nuevo" class="btn btn-primary"><i class="fas fa-plus"></i> Nuevo Producto</a>
        <a href="/admin/productos" class="btn btn-outline"><i class="fas fa-list"></i> Gestionar Productos</a>
        <a href="/admin/politicas" class="btn btn-outline"><i class="fas fa-file-alt"></i> Editar Políticas</a>
      </div>
    </div>
  </section>
<%- include('../partials/footer') %>
